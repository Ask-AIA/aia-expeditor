# Test environment for `pnpm test:int`. Copy to `.env.test` (git-ignored)
# and fill in the local values. Never commit `.env.test`.
NODE_ENV=test
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/expeditor
DATABASE_URL_TEST=postgresql://USER:PASSWORD@HOST:5432/expeditor_test
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=exp:test:

JWT_SECRET=test-jwt-secret-that-is-at-least-32-chars
COOKIE_SECRET=test-cookie-secret-that-is-at-least-32-c
ACCESS_TOKEN_TTL=15m
REFRESH_TTL_MANAGER=7d
REFRESH_TTL_STATION=30d
RESET_TOKEN_TTL=30m
